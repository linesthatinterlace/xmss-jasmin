/* xmss_sha2_10_256.jazz — XMSS-SHA2_10_256 production exports
 *
 * Parameter set: XMSS-SHA2_10_256 (RFC 8391, OID 0x00000001)
 * Tree height: 10, N: 32, W: 16
 *
 * Exports:
 *   jade_sign_xmss_sha2_10_256_amd64_ref_keypair
 *   jade_sign_xmss_sha2_10_256_amd64_ref
 *   jade_sign_xmss_sha2_10_256_amd64_ref_open
 */

param int N          = 32;
param int W          = 16;
param int LOG2_W     = 4;
param int LEN1       = 64;
param int LEN2       = 3;
param int LEN        = 67;
param int TREE_HEIGHT = 10;
param int BDS_K      = 2;
param int XMSS_OID   = 0x00000001;

require "../src/utils.jinc"
require "../src/address.jinc"
require "../src/hash/sha256_n32.jinc"
require "../src/wots.jinc"
require "../src/ltree.jinc"
require "../src/treehash.jinc"
require "../src/bds.jinc"
require "../src/xmss.jinc"

#[ct = "public × public × public × public × public → public"]
export fn jade_sign_xmss_sha2_10_256_amd64_ref_keypair(
    reg u64 pk, reg u64 sk, reg u64 state,
    reg u64 seeds, reg u64 scratch) -> reg u64 {
  reg u64 r;
  _ = #init_msf();
  r = __xmss_keygen(pk, sk, state, seeds, scratch);
  return r;
}

#[ct = "public × public × public × public × public × public → public"]
export fn jade_sign_xmss_sha2_10_256_amd64_ref(
    reg u64 sig, reg u64 msg, reg u64 msglen,
    reg u64 sk, reg u64 state,
    reg u64 scratch) -> reg u64 {
  reg u64 r;
  _ = #init_msf();
  r = __xmss_sign(sig, msg, msglen, sk, state, scratch);
  return r;
}

#[ct = "public × public × public × public × public → secret"]
export fn jade_sign_xmss_sha2_10_256_amd64_ref_open(
    reg u64 msg, reg u64 msglen, reg u64 sig,
    reg u64 pk, reg u64 scratch) -> reg u64 {
  reg u64 r;
  _ = #init_msf();
  r = __xmss_verify(msg, msglen, sig, pk, scratch);
  return r;
}
