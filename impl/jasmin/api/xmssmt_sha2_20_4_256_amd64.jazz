/* xmssmt_sha2_20_4_256.jazz — XMSSMT-SHA2_20/4_256 production exports
 *
 * Parameter set: XMSSMT-SHA2_20/4_256 (RFC 8391, OID 0x00000002)
 * D: 4, FULL_H: 20, TREE_HEIGHT: 5, N: 32, W: 16
 *
 * Exports:
 *   jade_sign_xmssmt_sha2_20_4_256_amd64_ref_keypair
 *   jade_sign_xmssmt_sha2_20_4_256_amd64_ref
 *   jade_sign_xmssmt_sha2_20_4_256_amd64_ref_open
 */

require "../src/params_xmssmt_sha2_20_4_256.jinc"

#[ct = "public × public × public × public × public → public"]
export fn jade_sign_xmssmt_sha2_20_4_256_amd64_ref_keypair(
    reg u64 pk, reg u64 sk, reg u64 mt_state,
    reg u64 seeds, reg u64 scratch) -> reg u64 {
  reg u64 r;
  _ = #init_msf();
  r = __xmssmt_keygen(pk, sk, mt_state, seeds, scratch);
  return r;
}

#[ct = "public × public × public × public × public × public → public"]
export fn jade_sign_xmssmt_sha2_20_4_256_amd64_ref(
    reg u64 sig, reg u64 msg, reg u64 msglen,
    reg u64 sk, reg u64 mt_state,
    reg u64 scratch) -> reg u64 {
  reg u64 r;
  _ = #init_msf();
  r = __xmssmt_sign(sig, msg, msglen, sk, mt_state, scratch);
  return r;
}

#[ct = "public × public × public × public × public → secret"]
export fn jade_sign_xmssmt_sha2_20_4_256_amd64_ref_open(
    reg u64 msg, reg u64 msglen, reg u64 sig,
    reg u64 pk, reg u64 scratch) -> reg u64 {
  reg u64 r;
  _ = #init_msf();
  r = __xmssmt_verify(msg, msglen, sig, pk, scratch);
  return r;
}
