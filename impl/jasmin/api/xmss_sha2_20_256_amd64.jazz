/* xmss_sha2_20_256.jazz — XMSS-SHA2_20_256 production exports
 *
 * Parameter set: XMSS-SHA2_20_256 (RFC 8391, OID 0x00000003)
 * Tree height: 20, N: 32, W: 16
 *
 * Exports:
 *   jade_sign_xmss_sha2_20_256_amd64_ref_keypair
 *   jade_sign_xmss_sha2_20_256_amd64_ref
 *   jade_sign_xmss_sha2_20_256_amd64_ref_open
 */

require "../src/params_xmss_sha2_20_256.jinc"

#[ct = "public × public × public × public × public → public"]
export fn jade_sign_xmss_sha2_20_256_amd64_ref_keypair(
    reg u64 pk, reg u64 sk, reg u64 state,
    reg u64 seeds, reg u64 scratch) -> reg u64 {
  reg u64 r;
  _ = #init_msf();
  r = __xmss_keygen(pk, sk, state, seeds, scratch);
  return r;
}

#[ct = "public × public × public × public × public × public → public"]
export fn jade_sign_xmss_sha2_20_256_amd64_ref(
    reg u64 sig, reg u64 msg, reg u64 msglen,
    reg u64 sk, reg u64 state,
    reg u64 scratch) -> reg u64 {
  reg u64 r;
  _ = #init_msf();
  r = __xmss_sign(sig, msg, msglen, sk, state, scratch);
  return r;
}

#[ct = "public × public × public × public × public → secret"]
export fn jade_sign_xmss_sha2_20_256_amd64_ref_open(
    reg u64 msg, reg u64 msglen, reg u64 sig,
    reg u64 pk, reg u64 scratch) -> reg u64 {
  reg u64 r;
  _ = #init_msf();
  r = __xmss_verify(msg, msglen, sig, pk, scratch);
  return r;
}
