/* bds.jinc — BDS tree traversal algorithm (Buchmann-Dahmen-Szydlo)
 *
 * Amortises auth path computation: signing is O(h) leaf computations
 * instead of O(h * 2^h).
 *
 * Requires: address.jinc, wots.jinc, ltree.jinc, hash backend.
 * Params: N, W, LOG2_W, LEN, LEN1, LEN2, TREE_HEIGHT, BDS_K (param int from .jazz).
 */

/* ====================================================================
 * Part A: BDS state flat-buffer layout
 *
 * The BDS state is a flat byte array, caller-provided via reg u64.
 *
 * Layout for H=TREE_HEIGHT, K=BDS_K, N=N:
 *   [0]                auth:         H * N bytes
 *   [H*N]              keep:         (H/2) * N bytes
 *   [(H+H/2)*N]        stack_nodes:  (H+1) * N bytes
 *   [+]                stack_levels: (H+1) bytes
 *   [+]                stack_offset: 4 bytes (u32)
 *   [+]                treehash:     (H-K) instances, each N+10 bytes
 *                        node[N], h(u32), next_idx(u32), stack_usage(u8), completed(u8)
 *   [+]                retain:       RETAIN_NODES * N bytes
 *   [+]                next_leaf:    4 bytes (u32)
 * ==================================================================== */

param int BDS_AUTH_OFF     = 0;
param int BDS_KEEP_OFF     = TREE_HEIGHT * N;
param int BDS_STACK_OFF    = (TREE_HEIGHT + TREE_HEIGHT / 2) * N;
param int BDS_LEVELS_OFF   = (TREE_HEIGHT + TREE_HEIGHT / 2 + TREE_HEIGHT + 1) * N;
param int BDS_STKOFF_OFF   = (TREE_HEIGHT + TREE_HEIGHT / 2 + TREE_HEIGHT + 1) * N + (TREE_HEIGHT + 1);
param int TH_INST_SIZE     = N + 10;
param int BDS_TH_OFF       = (TREE_HEIGHT + TREE_HEIGHT / 2 + TREE_HEIGHT + 1) * N + (TREE_HEIGHT + 1) + 4;
param int NUM_TH           = TREE_HEIGHT - BDS_K;
param int BDS_RETAIN_OFF   = BDS_TH_OFF + (TREE_HEIGHT - BDS_K) * (N + 10);
param int RETAIN_NODES     = (1 << BDS_K) - BDS_K - 1;
param int BDS_NEXTLEAF_OFF = BDS_RETAIN_OFF + ((1 << BDS_K) - BDS_K - 1) * N;
param int BDS_STATE_BYTES  = BDS_NEXTLEAF_OFF + 4;

/* ====================================================================
 * Part B: Field accessors (inline functions)
 * ==================================================================== */

/* auth[level] pointer — runtime level */
inline fn __bds_auth_ptr_rt(reg u64 state, reg u64 level) -> reg u64 {
  reg u64 p;
  p = level;
  p *= N;
  p += state;
  /* BDS_AUTH_OFF == 0, no add needed */
  return p;
}

/* keep[level] pointer — runtime level */
inline fn __bds_keep_ptr_rt(reg u64 state, reg u64 level) -> reg u64 {
  reg u64 p;
  p = level;
  p *= N;
  p += BDS_KEEP_OFF;
  p += state;
  return p;
}

/* stack node pointer — runtime offset */
inline fn __bds_stack_node_ptr(reg u64 state, reg u64 off) -> reg u64 {
  reg u64 p;
  p = off;
  p *= N;
  p += BDS_STACK_OFF;
  p += state;
  return p;
}

/* stack_levels[off] get/set — runtime off */
inline fn __bds_stack_level_get(reg u64 state, reg u64 off) -> reg u8 {
  reg u64 p; reg u8 v;
  p = off;
  p += BDS_LEVELS_OFF;
  p += state;
  v = [:u8 p];
  /* BDS stack levels are public (determined by public leaf index) */
  () = #declassify(v);
  return v;
}

inline fn __bds_stack_level_set(reg u64 state, reg u64 off, reg u8 val) {
  reg u64 p;
  p = off;
  p += BDS_LEVELS_OFF;
  p += state;
  [:u8 p] = val;
}

/* stack_offset get/set */
inline fn __bds_stack_offset_get(reg u64 state) -> reg u32 {
  reg u64 p; reg u32 v;
  p = state;
  p += BDS_STKOFF_OFF;
  v = [:u32 p];
  /* BDS stack offset is public (determined by public leaf index) */
  () = #declassify(v);
  return v;
}

inline fn __bds_stack_offset_set(reg u64 state, reg u32 val) {
  reg u64 p;
  p = state;
  p += BDS_STKOFF_OFF;
  [:u32 p] = val;
}

/* treehash runtime-indexed base pointer */
inline fn __th_base_rt(reg u64 state, reg u64 level) -> reg u64 {
  reg u64 p;
  p = level;
  p *= TH_INST_SIZE;
  p += BDS_TH_OFF;
  p += state;
  return p;
}

/* th[level].node pointer — runtime */
inline fn __th_node_ptr_rt(reg u64 state, reg u64 level) -> reg u64 {
  reg u64 p;
  p = __th_base_rt(state, level);
  return p;
}

/* th[level].h get/set — runtime */
inline fn __th_h_get_rt(reg u64 state, reg u64 level) -> reg u32 {
  reg u64 p; reg u32 v;
  p = __th_base_rt(state, level);
  p += N;
  v = [:u32 p];
  /* Treehash height is public (tree structure parameter) */
  () = #declassify(v);
  return v;
}

inline fn __th_h_set_rt(reg u64 state, reg u64 level, reg u32 val) {
  reg u64 p;
  p = __th_base_rt(state, level);
  p += N;
  [:u32 p] = val;
}

/* th[level].next_idx get/set — runtime */
inline fn __th_next_idx_get_rt(reg u64 state, reg u64 level) -> reg u32 {
  reg u64 p; reg u32 v;
  p = __th_base_rt(state, level);
  p += N + 4;
  v = [:u32 p];
  /* Treehash next_idx is public (determined by public leaf counter) */
  () = #declassify(v);
  return v;
}

inline fn __th_next_idx_set_rt(reg u64 state, reg u64 level, reg u32 val) {
  reg u64 p;
  p = __th_base_rt(state, level);
  p += N + 4;
  [:u32 p] = val;
}

/* th[level].stack_usage get/set — runtime */
inline fn __th_stack_usage_get_rt(reg u64 state, reg u64 level) -> reg u8 {
  reg u64 p; reg u8 v;
  p = __th_base_rt(state, level);
  p += N + 8;
  v = [:u8 p];
  /* Treehash stack_usage is public (determined by public leaf counter) */
  () = #declassify(v);
  return v;
}

inline fn __th_stack_usage_set_rt(reg u64 state, reg u64 level, reg u8 val) {
  reg u64 p;
  p = __th_base_rt(state, level);
  p += N + 8;
  [:u8 p] = val;
}

/* th[level].completed get/set — runtime */
inline fn __th_completed_get_rt(reg u64 state, reg u64 level) -> reg u8 {
  reg u64 p; reg u8 v;
  p = __th_base_rt(state, level);
  p += N + 9;
  v = [:u8 p];
  /* Treehash completed flag is public (tree structure state) */
  () = #declassify(v);
  return v;
}

inline fn __th_completed_set_rt(reg u64 state, reg u64 level, reg u8 val) {
  reg u64 p;
  p = __th_base_rt(state, level);
  p += N + 9;
  [:u8 p] = val;
}

/* retain[slot] pointer — runtime slot */
inline fn __bds_retain_ptr(reg u64 state, reg u64 slot) -> reg u64 {
  reg u64 p;
  p = slot;
  p *= N;
  p += BDS_RETAIN_OFF;
  p += state;
  return p;
}

/* next_leaf get/set */
inline fn __bds_next_leaf_get(reg u64 state) -> reg u32 {
  reg u64 p; reg u32 v;
  p = state;
  p += BDS_NEXTLEAF_OFF;
  v = [:u32 p];
  /* next_leaf is a public counter */
  () = #declassify(v);
  return v;
}

inline fn __bds_next_leaf_set(reg u64 state, reg u32 val) {
  reg u64 p;
  p = state;
  p += BDS_NEXTLEAF_OFF;
  [:u32 p] = val;
}

/* ====================================================================
 * Part C: __gen_leaf — compute a single Merkle leaf
 *
 * leaf_ptr:  output, N bytes
 * sk_seed:   N-byte secret seed
 * seed:      N-byte public seed
 * leaf_idx:  index of this leaf
 * adrs_buf:  32-byte scratch for ADRS serialisation
 * adrs_rp:   ADRS with layer/tree set by caller
 * wots_buf:  LEN*N bytes scratch for WOTS+ pk
 * ==================================================================== */
fn __gen_leaf(reg u64 leaf_ptr, reg u64 sk_seed, reg u64 seed,
              reg u32 leaf_idx, reg u64 adrs_buf,
              reg ptr u32[8] adrs_rp, reg u64 wots_buf) {
  stack u32[8] adrs;
  stack u8[32] adrs_bytes;
  stack u64 s_leaf s_sk s_seed s_adrs_buf s_wots;
  stack u32 s_leaf_idx;
  reg ptr u32[8] adrs_p;
  reg u8 b;
  inline int j;

  /* Spill everything */
  for j = 0 to 8 { adrs[j] = adrs_rp[j]; }
  s_leaf = leaf_ptr;
  s_sk = sk_seed;
  s_seed = seed;
  s_adrs_buf = adrs_buf;
  s_wots = wots_buf;
  s_leaf_idx = leaf_idx;

  /* Step 1: Set OTS ADRS, generate WOTS+ pk into wots_buf */
  adrs = __adrs_set_type(adrs, 0);
  leaf_idx = s_leaf_idx;
  adrs = __adrs_set_ots(adrs, leaf_idx);

  wots_buf = s_wots;
  sk_seed = s_sk;
  seed = s_seed;
  adrs_p = adrs;
  __wots_gen_pk(wots_buf, sk_seed, seed, adrs_p);

  /* Step 2: Set LTREE ADRS, compress wots_buf into leaf_ptr */
  adrs = __adrs_set_type(adrs, 1);
  leaf_idx = s_leaf_idx;
  adrs = __adrs_set_ltree(adrs, leaf_idx);

  adrs_bytes = __adrs_to_bytes(adrs);
  adrs_buf = s_adrs_buf;
  for j = 0 to 32 { b = adrs_bytes[j]; [:u8 adrs_buf + j] = b; }

  leaf_ptr = s_leaf;
  seed = s_seed;
  adrs_buf = s_adrs_buf;
  wots_buf = s_wots;
  adrs_p = adrs;
  __ltree(leaf_ptr, wots_buf, seed, adrs_buf, adrs_p);
}

/* ====================================================================
 * Part D: __bds_treehash_init — Build full tree, capturing BDS state
 *
 * root:      output, N bytes
 * state:     BDS state buffer (BDS_STATE_BYTES)
 * sk_seed:   N-byte secret seed
 * seed:      N-byte public seed
 * adrs_buf:  32-byte scratch for ADRS serialisation
 * adrs_rp:   ADRS with layer/tree set by caller
 * wots_buf:  LEN*N bytes scratch for WOTS+ pk
 * ==================================================================== */
fn __bds_treehash_init(reg u64 root, reg u64 state, reg u64 sk_seed,
                       reg u64 seed, reg u64 adrs_buf,
                       reg ptr u32[8] adrs_rp, reg u64 wots_buf) {
  /* Local stack for the full tree build */
  stack u8[(TREE_HEIGHT + 1) * N] nodes;
  stack u32[TREE_HEIGHT + 1] heights;

  stack u32[8] adrs;
  stack u8[32] adrs_bytes;

  /* Spill slots */
  stack u64 s_root s_state s_sk s_seed s_adrs_buf s_wots s_stkoff;
  stack u32 s_idx;

  reg u64 stkoff dst nodeh64;
  reg u32 idx32 nodeh;
  reg u32 i_shifted th_h0 th_zero;
  reg u64 tmp tmp2;
  reg u64 h_out h_seed h_adrs h_left h_right;
  reg u8 b comp;
  reg ptr u32[8] adrs_p;
  inline int j ii;

  /* Spill inputs */
  for j = 0 to 8 { adrs[j] = adrs_rp[j]; }
  s_root = root;
  s_state = state;
  s_sk = sk_seed;
  s_seed = seed;
  s_adrs_buf = adrs_buf;
  s_wots = wots_buf;

  /* Initialise treehash instances as completed */
  for ii = 0 to NUM_TH {
    state = s_state;
    th_h0 = ii;
    __th_h_set_rt(state, (64u)ii, th_h0);
    comp = 1;
    __th_completed_set_rt(state, (64u)ii, comp);
    b = 0;
    __th_stack_usage_set_rt(state, (64u)ii, b);
  }

  /* Initialise shared stack offset and next_leaf */
  state = s_state;
  th_zero = 0;
  __bds_stack_offset_set(state, th_zero);
  __bds_next_leaf_set(state, th_zero);

  /* Zero local heights */
  for j = 0 to TREE_HEIGHT + 1 { heights[j] = 0; }

  stkoff = 0;  /* local stack offset (u64 for safe stack indexing) */
  s_stkoff = stkoff;

  /* Main loop: iterate 2^TREE_HEIGHT leaves */
  idx32 = 0;

  while (idx32 <u 1 << TREE_HEIGHT) {
    s_idx = idx32;

    /* --- gen_leaf into nodes[stkoff] --- */
    /* Use root as a temporary leaf output buffer (N bytes), then copy
     * to nodes[stkoff]. Root is N bytes and isn't needed until the end. */

    root = s_root;
    sk_seed = s_sk;
    seed = s_seed;
    idx32 = s_idx;
    adrs_buf = s_adrs_buf;
    adrs_p = adrs;
    wots_buf = s_wots;
    __gen_leaf(root, sk_seed, seed, idx32, adrs_buf, adrs_p, wots_buf);

    /* Copy root (leaf output) → nodes[stkoff] */
    root = s_root;
    stkoff = s_stkoff;
    tmp = stkoff;
    tmp *= N;
    for j = 0 to N {
      b = [:u8 root + j];
      nodes[(uint)(tmp + j)] = b;
    }

    /* heights[stkoff] = 0 */
    heights[(uint)stkoff] = 0;
    stkoff += 1;
    s_stkoff = stkoff;

    /* --- Merge while top two have equal height --- */
    while {
      stkoff = s_stkoff;
      comp = 0;
      if (stkoff >=u 2) {
        nodeh = heights[(uint)(stkoff - 2)];
        th_h0 = heights[(uint)(stkoff - 1)];
        if (nodeh == th_h0) { comp = 1; }
      }
    } (comp == 1) {
      nodeh = heights[(uint)(stkoff - 2)];
      nodeh64 = (64u)nodeh;

      /* --- Capture BDS state nodes --- */
      /* Compute i_shifted = idx >> nodeh using constant-shift loop */
      idx32 = s_idx;
      i_shifted = idx32;
      th_h0 = nodeh;
      while (th_h0 >u 0) {
        i_shifted >>= 1;
        th_h0 -= 1;
      }

      state = s_state;

      /* Auth path: (idx >> nodeh) == 1 */
      if (i_shifted == 1) {
        /* Copy nodes[stkoff-1] to auth[nodeh] */
        stkoff = s_stkoff;
        stkoff -= 1;
        tmp = stkoff;
        tmp *= N;
        dst = __bds_auth_ptr_rt(state, nodeh64);
        for j = 0 to N {
          b = nodes[(uint)(tmp + j)];
          [:u8 dst + j] = b;
        }
      } else {
        /* Treehash starting node: nodeh < H-K && (idx>>nodeh) == 3 */
        if (i_shifted == 3) {
          if (nodeh <u TREE_HEIGHT - BDS_K) {
            stkoff = s_stkoff;
            stkoff -= 1;
            tmp = stkoff;
            tmp *= N;
            state = s_state;
            dst = __th_node_ptr_rt(state, nodeh64);
            for j = 0 to N {
              b = nodes[(uint)(tmp + j)];
              [:u8 dst + j] = b;
            }
          }
        }

        /* Retain node: nodeh >= H-K (only when not auth or treehash) */
        if (nodeh >=u TREE_HEIGHT - BDS_K) {
          /* off = (1 << (H-1-nodeh)) + nodeh - H */
          /* row = ((idx >> nodeh) - 3) >> 1 */
          tmp = 1;
          th_h0 = TREE_HEIGHT - 1;
          th_h0 -= nodeh;
          /* shift tmp left by th_h0 using loop */
          while (th_h0 >u 0) {
            tmp <<= 1;
            th_h0 -= 1;
          }
          tmp += nodeh64;
          tmp -= TREE_HEIGHT;

          tmp2 = (64u)i_shifted;
          tmp2 -= 3;
          tmp2 >>= 1;
          tmp += tmp2;  /* slot = off + row */

          stkoff = s_stkoff;
          stkoff -= 1;
          state = s_state;
          dst = __bds_retain_ptr(state, tmp);
          tmp = stkoff;
          tmp *= N;
          for j = 0 to N {
            b = nodes[(uint)(tmp + j)];
            [:u8 dst + j] = b;
          }
        }
      }

      /* --- Merge: H(left=nodes[stkoff-2], right=nodes[stkoff-1]) → nodes[stkoff-2] --- */
      /* Set ADRS: type=2, tree_height=nodeh, tree_index=idx>>(nodeh+1) */
      adrs = __adrs_set_type(adrs, 2);
      stkoff = s_stkoff; /* reload — capture blocks above clobbered stkoff */
      nodeh = heights[(uint)(stkoff - 2)];
      adrs = __adrs_set_tree_height(adrs, nodeh);

      /* tree_index = idx >> (nodeh+1) via constant-shift loop */
      idx32 = s_idx;
      th_h0 = nodeh;
      th_h0 += 1;
      i_shifted = idx32;
      while (th_h0 >u 0) {
        i_shifted >>= 1;
        th_h0 -= 1;
      }
      adrs = __adrs_set_tree_index(adrs, i_shifted);

      adrs_bytes = __adrs_to_bytes(adrs);
      adrs_buf = s_adrs_buf;
      for j = 0 to 32 { b = adrs_bytes[j]; [:u8 adrs_buf + j] = b; }

      /* Copy left and right nodes into wots_buf[0..2N-1], call H, copy back */
      stkoff = s_stkoff;
      stkoff -= 2;
      tmp = stkoff;
      tmp *= N;
      wots_buf = s_wots;
      /* Copy left (nodes[stkoff-2]) to wots_buf[0..N-1] */
      for j = 0 to N {
        b = nodes[(uint)(tmp + j)];
        [:u8 wots_buf + j] = b;
      }
      /* Copy right (nodes[stkoff-1]) to wots_buf[N..2N-1] */
      stkoff = s_stkoff;
      stkoff -= 1;
      tmp = stkoff;
      tmp *= N;
      tmp2 = s_wots;
      tmp2 += N;
      for j = 0 to N {
        b = nodes[(uint)(tmp + j)];
        [:u8 tmp2 + j] = b;
      }

      /* Call H(out, seed, adrs_buf, left, right) — all from separate reloads */
      h_out = s_wots;
      h_left = s_wots;
      h_right = s_wots;
      h_right += N;
      h_seed = s_seed;
      h_adrs = s_adrs_buf;
      __xmss_H(h_out, h_seed, h_adrs, h_left, h_right);

      /* Copy result (wots_buf[0..N-1]) back to nodes[stkoff-2] */
      stkoff = s_stkoff;
      stkoff -= 2;
      tmp = stkoff;
      tmp *= N;
      wots_buf = s_wots;
      for j = 0 to N {
        b = [:u8 wots_buf + j];
        nodes[(uint)(tmp + j)] = b;
      }

      /* Update heights and stack offset */
      stkoff = s_stkoff;
      stkoff -= 2;
      nodeh = heights[(uint)stkoff];
      nodeh += 1;
      heights[(uint)stkoff] = nodeh;
      stkoff += 1;
      s_stkoff = stkoff;
    }

    idx32 = s_idx;
    idx32 += 1;
  }

  /* Root is nodes[0..N-1] */
  root = s_root;
  for j = 0 to N { b = nodes[j]; [:u8 root + j] = b; }
}

/* ====================================================================
 * Part F: __treehash_update_one — Process one leaf for a treehash instance
 *
 * state:     BDS state buffer
 * level:     treehash instance index (runtime)
 * sk_seed, seed, adrs_buf, adrs_rp, wots_buf: as usual
 * ==================================================================== */
fn __treehash_update_one(reg u64 state, reg u64 level, reg u64 sk_seed,
                         reg u64 seed, reg u64 adrs_buf,
                         reg ptr u32[8] adrs_rp, reg u64 wots_buf) {
  stack u8[2 * N] nodebuf;
  stack u32[8] adrs;
  stack u8[32] adrs_bytes;

  stack u64 s_state s_level s_sk s_seed s_adrs_buf s_wots;
  stack u32 s_nodeheight;

  reg u64 src dst tmp;
  reg u64 h_out h_seed h_adrs h_left h_right;
  reg u32 nodeheight next_idx tidx stk_off th_h;
  reg u8 su stkl comp b one_u8;
  reg ptr u32[8] adrs_p;
  inline int j;

  for j = 0 to 8 { adrs[j] = adrs_rp[j]; }
  s_state = state;
  s_level = level;
  s_sk = sk_seed;
  s_seed = seed;
  s_adrs_buf = adrs_buf;
  s_wots = wots_buf;

  /* Generate leaf at th[level].next_idx into nodebuf[0..N-1].
   * Leaf output goes to wots_buf + LEN*N (past the WOTS scratch area),
   * then is copied into nodebuf. Caller must provide LEN*N + N bytes. */
  state = s_state;
  level = s_level;
  next_idx = __th_next_idx_get_rt(state, level);

  wots_buf = s_wots;
  tmp = wots_buf;
  tmp += LEN * N;  /* leaf output at end of wots_buf region */

  sk_seed = s_sk;
  seed = s_seed;
  adrs_buf = s_adrs_buf;
  adrs_p = adrs;
  wots_buf = s_wots;
  __gen_leaf(tmp, sk_seed, seed, next_idx, adrs_buf, adrs_p, wots_buf);

  /* Copy leaf from wots_buf + LEN*N into nodebuf[0..N-1] */
  tmp = s_wots;
  tmp += LEN * N;
  for j = 0 to N {
    b = [:u8 tmp + j];
    nodebuf[j] = b;
  }

  nodeheight = 0;
  s_nodeheight = nodeheight;

  /* Merge with shared stack while heights match */
  while {
    state = s_state;
    level = s_level;
    su = __th_stack_usage_get_rt(state, level);
    comp = 0;
    if (su >u 0) {
      stk_off = __bds_stack_offset_get(state);
      stk_off -= 1;
      tmp = (64u)stk_off;
      stkl = __bds_stack_level_get(state, tmp);
      nodeheight = s_nodeheight;
      if (stkl == (8u)nodeheight) {
        comp = 1;
      }
    }
  } (comp == 1) {
    /* Current node becomes right child, stack top becomes left */
    /* Copy nodebuf[0..N-1] to nodebuf[N..2N-1] (right child) */
    for j = 0 to N {
      b = nodebuf[j];
      nodebuf[N + j] = b;
    }

    /* Copy state->stack[stack_offset-1] to nodebuf[0..N-1] (left child) */
    state = s_state;
    stk_off = __bds_stack_offset_get(state);
    stk_off -= 1;
    tmp = (64u)stk_off;
    src = __bds_stack_node_ptr(state, tmp);
    for j = 0 to N {
      b = [:u8 src + j];
      nodebuf[j] = b;
    }

    /* Set ADRS: type=2, tree_height=nodeheight */
    adrs = __adrs_set_type(adrs, 2);
    nodeheight = s_nodeheight;
    adrs = __adrs_set_tree_height(adrs, nodeheight);

    /* tree_index = next_idx >> (nodeheight+1) via constant-shift loop */
    state = s_state;
    level = s_level;
    next_idx = __th_next_idx_get_rt(state, level);
    tidx = next_idx;
    nodeheight = s_nodeheight;
    nodeheight += 1;
    while (nodeheight >u 0) {
      tidx >>= 1;
      nodeheight -= 1;
    }
    adrs = __adrs_set_tree_index(adrs, tidx);

    adrs_bytes = __adrs_to_bytes(adrs);
    adrs_buf = s_adrs_buf;
    for j = 0 to 32 { b = adrs_bytes[j]; [:u8 adrs_buf + j] = b; }

    /* Copy nodebuf to wots_buf[0..2N-1] for H call */
    wots_buf = s_wots;
    for j = 0 to N {
      b = nodebuf[j];
      [:u8 wots_buf + j] = b;
    }
    wots_buf = s_wots;
    tmp = wots_buf;
    tmp += N;
    for j = 0 to N {
      b = nodebuf[N + j];
      [:u8 tmp + j] = b;
    }

    /* H(out, seed, adrs_buf, left, right) — all from separate reloads */
    h_out = s_wots;
    h_left = s_wots;
    h_right = s_wots;
    h_right += N;
    h_seed = s_seed;
    h_adrs = s_adrs_buf;
    __xmss_H(h_out, h_seed, h_adrs, h_left, h_right);

    /* Copy result back to nodebuf[0..N-1] */
    wots_buf = s_wots;
    for j = 0 to N {
      b = [:u8 wots_buf + j];
      nodebuf[j] = b;
    }

    nodeheight = s_nodeheight;
    nodeheight += 1;
    s_nodeheight = nodeheight;

    /* stack_usage--, stack_offset-- */
    state = s_state;
    level = s_level;
    su = __th_stack_usage_get_rt(state, level);
    su -= 1;
    __th_stack_usage_set_rt(state, level, su);
    stk_off = __bds_stack_offset_get(state);
    stk_off -= 1;
    __bds_stack_offset_set(state, stk_off);
  }

  /* Check if target height reached */
  state = s_state;
  level = s_level;
  th_h = __th_h_get_rt(state, level);
  nodeheight = s_nodeheight;

  if (nodeheight == th_h) {
    /* Save result in th[level].node, mark completed */
    dst = __th_node_ptr_rt(state, level);
    for j = 0 to N {
      b = nodebuf[j];
      [:u8 dst + j] = b;
    }
    state = s_state;
    level = s_level;
    one_u8 = 1;
    __th_completed_set_rt(state, level, one_u8);
  } else {
    /* Push onto shared stack */
    stk_off = __bds_stack_offset_get(state);
    tmp = (64u)stk_off;
    dst = __bds_stack_node_ptr(state, tmp);
    for j = 0 to N {
      b = nodebuf[j];
      [:u8 dst + j] = b;
    }

    /* Update stack_usage, stack_levels, stack_offset, next_idx */
    state = s_state;
    level = s_level;
    su = __th_stack_usage_get_rt(state, level);
    su += 1;
    __th_stack_usage_set_rt(state, level, su);

    stk_off = __bds_stack_offset_get(state);
    nodeheight = s_nodeheight;
    b = (8u)nodeheight;
    tmp = (64u)stk_off;
    __bds_stack_level_set(state, tmp, b);
    stk_off += 1;
    __bds_stack_offset_set(state, stk_off);

    next_idx = __th_next_idx_get_rt(state, level);
    next_idx += 1;
    __th_next_idx_set_rt(state, level, next_idx);
  }
}

/* ====================================================================
 * Part G: __bds_treehash_update — Run incremental treehash updates
 *
 * state:     BDS state buffer
 * updates:   number of leaf computations to run
 * sk_seed, seed, adrs_buf, adrs_rp, wots_buf: as usual
 * ==================================================================== */
fn __bds_treehash_update(reg u64 state, reg u32 updates, reg u64 sk_seed,
                         reg u64 seed, reg u64 adrs_buf,
                         reg ptr u32[8] adrs_rp, reg u64 wots_buf) {
  stack u32[8] adrs;
  stack u64 s_state s_sk s_seed s_adrs_buf s_wots;
  stack u32 s_updates s_j;

  reg u64 level i64 tmp l_min low_val;
  reg u32 j i32 stkoff_u32;
  reg u8 comp su;
  reg ptr u32[8] adrs_p;
  inline int jj;

  for jj = 0 to 8 { adrs[jj] = adrs_rp[jj]; }
  s_state = state;
  s_sk = sk_seed;
  s_seed = seed;
  s_adrs_buf = adrs_buf;
  s_wots = wots_buf;
  s_updates = updates;

  j = 0;
  while {
    updates = s_updates;
  } (j <u updates) {
    s_j = j;

    l_min = TREE_HEIGHT;
    level = NUM_TH;  /* default: no instance found */

    /* Find most-urgent treehash instance */
    i64 = 0;
    while (i64 <u NUM_TH) {
      state = s_state;
      comp = __th_completed_get_rt(state, i64);
      if (comp != 0) {
        low_val = TREE_HEIGHT;
      } else {
        su = __th_stack_usage_get_rt(state, i64);
        if (su == 0) {
          low_val = i64;
        } else {
          /* Find min height on stack for this instance */
          low_val = TREE_HEIGHT;
          /* Simple: scan stack from stack_offset-1 down for stack_usage entries */
          stkoff_u32 = __bds_stack_offset_get(state);
          i32 = (32u)su;
          while (i32 >u 0) {
            stkoff_u32 -= 1;
            tmp = (64u)stkoff_u32;
            comp = __bds_stack_level_get(state, tmp);
            i32 -= 1;
            tmp = (64u)comp;
            if (tmp <u low_val) {
              low_val = tmp;
            }
          }
        }
      }

      if (low_val <u l_min) {
        level = i64;
        l_min = low_val;
      }

      i64 += 1;
    }

    /* No incomplete instance found */
    if (level >=u NUM_TH) {
      /* break — set j = updates to exit */
      j = s_updates;
      s_j = j;
    } else {
      /* Call treehash_update_one */
      state = s_state;
      sk_seed = s_sk;
      seed = s_seed;
      adrs_buf = s_adrs_buf;
      adrs_p = adrs;
      wots_buf = s_wots;
      __treehash_update_one(state, level, sk_seed, seed, adrs_buf, adrs_p, wots_buf);
    }

    j = s_j;
    j += 1;
  }
}

/* ====================================================================
 * Part E: __bds_round — Update auth path after signing leaf_idx
 *
 * state:     BDS state buffer
 * leaf_idx:  leaf index just signed
 * sk_seed, seed, adrs_buf, adrs_rp, wots_buf: as usual
 * ==================================================================== */
fn __bds_round(reg u64 state, reg u32 leaf_idx, reg u64 sk_seed,
               reg u64 seed, reg u64 adrs_buf,
               reg ptr u32[8] adrs_rp, reg u64 wots_buf) {
  stack u32[8] adrs;
  stack u8[32] adrs_bytes;

  stack u64 s_state s_sk s_seed s_adrs_buf s_wots;
  stack u32 s_leaf_idx s_tau;

  reg u64 tau64 i64 tmp src dst;
  reg u64 h_out h_seed h_adrs h_left h_right;
  reg u32 tau i32 shifted bit_val leaf_val th_h0 startidx;
  reg u8 b;
  reg ptr u32[8] adrs_p;
  inline int j;

  for j = 0 to 8 { adrs[j] = adrs_rp[j]; }
  s_state = state;
  s_sk = sk_seed;
  s_seed = seed;
  s_adrs_buf = adrs_buf;
  s_wots = wots_buf;
  s_leaf_idx = leaf_idx;

  /* Find tau: lowest bit position where leaf_idx has a 0 */
  tau = TREE_HEIGHT;
  i32 = 0;
  while (i32 <u TREE_HEIGHT) {
    /* Check (leaf_idx >> i32) & 1 using constant-shift loop */
    leaf_val = s_leaf_idx;
    shifted = leaf_val;
    th_h0 = i32;
    while (th_h0 >u 0) {
      shifted >>= 1;
      th_h0 -= 1;
    }
    bit_val = shifted;
    bit_val &= 1;
    if (bit_val == 0) {
      tau = i32;
      i32 = TREE_HEIGHT;  /* break */
    } else {
      i32 += 1;
    }
  }

  s_tau = tau;
  tau64 = (64u)tau;

  /* Save nodes needed for merge before overwriting */
  if (tau >u 0) {
    /* Copy auth[tau-1] to wots_buf[0..N-1] (temp storage for buf[0..N-1]) */
    state = s_state;
    tmp = tau64;
    tmp -= 1;
    src = __bds_auth_ptr_rt(state, tmp);
    wots_buf = s_wots;
    for j = 0 to N {
      b = [:u8 src + j];
      [:u8 wots_buf + j] = b;
    }

    /* Copy keep[(tau-1)/2] to wots_buf[N..2N-1] */
    state = s_state;
    tmp = tau64;
    tmp -= 1;
    tmp >>= 1;
    src = __bds_keep_ptr_rt(state, tmp);
    wots_buf = s_wots;
    dst = wots_buf;
    dst += N;
    for j = 0 to N {
      b = [:u8 src + j];
      [:u8 dst + j] = b;
    }
  }

  /* Possibly save current auth[tau] to keep for future use */
  /* if (!((leaf_idx >> (tau+1)) & 1) && tau < H-1) */
  tau = s_tau;
  if (tau <u TREE_HEIGHT - 1) {
    leaf_val = s_leaf_idx;
    shifted = leaf_val;
    th_h0 = tau;
    th_h0 += 1;
    while (th_h0 >u 0) {
      shifted >>= 1;
      th_h0 -= 1;
    }
    bit_val = shifted;
    bit_val &= 1;
    if (bit_val == 0) {
      state = s_state;
      tau64 = (64u)tau;
      src = __bds_auth_ptr_rt(state, tau64);
      tmp = tau64;
      tmp >>= 1;
      dst = __bds_keep_ptr_rt(state, tmp);
      for j = 0 to N {
        b = [:u8 src + j];
        [:u8 dst + j] = b;
      }
    }
  }

  tau = s_tau;
  if (tau == 0) {
    /* Compute new leaf directly into auth[0] */
    state = s_state;
    tmp = 0;
    dst = __bds_auth_ptr_rt(state, tmp);

    leaf_val = s_leaf_idx;
    sk_seed = s_sk;
    seed = s_seed;
    adrs_buf = s_adrs_buf;
    adrs_p = adrs;
    wots_buf = s_wots;
    /* gen_leaf writes to dst=auth[0], uses wots_buf as scratch.
     * But we saved buf in wots_buf[0..2N-1]! tau==0 means we didn't save
     * anything there (the if(tau>0) block was skipped), so it's safe. */
    __gen_leaf(dst, sk_seed, seed, leaf_val, adrs_buf, adrs_p, wots_buf);
  } else {
    /* Merge auth[tau-1] and keep[(tau-1)/2] to get new auth[tau] */
    /* buf[0..N-1] = auth[tau-1] (in wots_buf[0])
     * buf[N..2N-1] = keep[(tau-1)/2] (in wots_buf[N]) */
    adrs = __adrs_set_type(adrs, 2);
    tau = s_tau;
    tau -= 1;
    adrs = __adrs_set_tree_height(adrs, tau);

    /* tree_index = leaf_idx >> tau */
    leaf_val = s_leaf_idx;
    tau = s_tau;
    shifted = leaf_val;
    while (tau >u 0) {
      shifted >>= 1;
      tau -= 1;
    }
    adrs = __adrs_set_tree_index(adrs, shifted);

    adrs_bytes = __adrs_to_bytes(adrs);
    adrs_buf = s_adrs_buf;
    for j = 0 to 32 { b = adrs_bytes[j]; [:u8 adrs_buf + j] = b; }

    /* H(out=auth[tau], seed, adrs_buf, left=wots_buf[0], right=wots_buf[N]) */
    state = s_state;
    tau = s_tau;
    tau64 = (64u)tau;
    h_out = __bds_auth_ptr_rt(state, tau64);
    h_left = s_wots;
    h_right = s_wots;
    h_right += N;
    h_seed = s_seed;
    h_adrs = s_adrs_buf;
    __xmss_H(h_out, h_seed, h_adrs, h_left, h_right);

    /* Fill auth[0..tau-1] from treehash nodes or retain */
    i64 = 0;
    while {
      tau = s_tau;
      tau64 = (64u)tau;
    } (i64 <u tau64) {
      state = s_state;

      if ((32u)i64 <u TREE_HEIGHT - BDS_K) {
        /* auth[i] = treehash[i].node */
        src = __th_node_ptr_rt(state, i64);
        dst = __bds_auth_ptr_rt(state, i64);
        for j = 0 to N {
          b = [:u8 src + j];
          [:u8 dst + j] = b;
        }
      } else {
        /* Retain: off = (1<<(H-1-i)) + i - H, row = ((leaf_idx>>i) - 1) >> 1 */
        tmp = 1;
        th_h0 = TREE_HEIGHT - 1;
        th_h0 -= (32u)i64;
        while (th_h0 >u 0) {
          tmp <<= 1;
          th_h0 -= 1;
        }
        tmp += i64;
        tmp -= TREE_HEIGHT;

        /* (leaf_idx >> i) via constant-shift loop */
        leaf_val = s_leaf_idx;
        shifted = leaf_val;
        th_h0 = (32u)i64;
        while (th_h0 >u 0) {
          shifted >>= 1;
          th_h0 -= 1;
        }
        tau64 = (64u)shifted;
        tau64 -= 1;
        tau64 >>= 1;
        tmp += tau64;  /* slot = off + row */

        state = s_state;
        src = __bds_retain_ptr(state, tmp);
        dst = __bds_auth_ptr_rt(state, i64);
        for j = 0 to N {
          b = [:u8 src + j];
          [:u8 dst + j] = b;
        }
      }

      i64 += 1;
    }

    /* Reinitialise treehash instances for levels below tau */
    i64 = 0;
    while {
      tau = s_tau;
      tau64 = (64u)tau;
    } (i64 <u tau64) {
      if ((32u)i64 <u TREE_HEIGHT - BDS_K) {
        /* startidx = leaf_idx + 1 + 3 * (1 << i) */
        leaf_val = s_leaf_idx;
        startidx = leaf_val;
        startidx += 1;
        th_h0 = 3;
        /* 1 << i via constant-shift loop */
        shifted = 1;
        i32 = (32u)i64;
        while (i32 >u 0) {
          shifted <<= 1;
          i32 -= 1;
        }
        th_h0 *= shifted;
        startidx += th_h0;

        if (startidx <u 1 << TREE_HEIGHT) {
          state = s_state;
          th_h0 = (32u)i64;
          __th_h_set_rt(state, i64, th_h0);
          __th_next_idx_set_rt(state, i64, startidx);
          b = 0;
          __th_completed_set_rt(state, i64, b);
          __th_stack_usage_set_rt(state, i64, b);
        }
      }

      i64 += 1;
    }
  }
}

/* ====================================================================
 * Part H: __bds_state_update — Incrementally build one leaf of a tree
 *
 * Used by XMSS-MT to pre-compute the "next" tree at each layer.
 * Each call generates one leaf, pushes it onto the BDS stack, and
 * merges while top two entries have equal height — capturing auth,
 * treehash, and retain nodes along the way.
 *
 * state:     BDS state buffer (next_leaf tracks progress)
 * sk_seed, seed, adrs_buf, adrs_rp, wots_buf: as usual
 *
 * Returns 0 on success, 1 if tree already complete (next_leaf >= 2^H).
 * ==================================================================== */
fn __bds_state_update(reg u64 state, reg u64 sk_seed, reg u64 seed,
                      reg u64 adrs_buf, reg ptr u32[8] adrs_rp,
                      reg u64 wots_buf) -> reg u64 {
  stack u32[8] adrs;
  stack u8[32] adrs_bytes;

  stack u64 s_state s_sk s_seed s_adrs_buf s_wots;
  stack u32 s_idx;

  reg u64 ret stkoff dst tmp tmp2 nodeh64;
  reg u64 h_out h_seed h_adrs h_left h_right;
  reg u32 idx32 nodeh stkoff32 i_shifted th_h0;
  reg u8 b comp slvl;
  reg ptr u32[8] adrs_p;
  inline int j;

  for j = 0 to 8 { adrs[j] = adrs_rp[j]; }
  s_state = state;
  s_sk = sk_seed;
  s_seed = seed;
  s_adrs_buf = adrs_buf;
  s_wots = wots_buf;

  /* Read next_leaf; if >= 2^TREE_HEIGHT, tree is complete */
  idx32 = __bds_next_leaf_get(state);

  ret = 1;
  if (idx32 <u 1 << TREE_HEIGHT) {
    s_idx = idx32;

    /* Generate leaf at index idx32 into wots_buf + LEN*N (past scratch),
     * then push onto BDS stack. */
    wots_buf = s_wots;
    tmp = wots_buf;
    tmp += LEN * N;

    sk_seed = s_sk;
    seed = s_seed;
    adrs_buf = s_adrs_buf;
    adrs_p = adrs;
    wots_buf = s_wots;
    __gen_leaf(tmp, sk_seed, seed, idx32, adrs_buf, adrs_p, wots_buf);

    /* Copy leaf from wots_buf + LEN*N to stack[stack_offset] */
    state = s_state;
    stkoff32 = __bds_stack_offset_get(state);
    stkoff = (64u)stkoff32;
    dst = __bds_stack_node_ptr(state, stkoff);

    tmp = s_wots;
    tmp += LEN * N;
    for j = 0 to N {
      b = [:u8 tmp + j];
      [:u8 dst + j] = b;
    }

    /* stack_levels[stack_offset] = 0 */
    state = s_state;
    stkoff32 = __bds_stack_offset_get(state);
    stkoff = (64u)stkoff32;
    b = 0;
    __bds_stack_level_set(state, stkoff, b);

    /* stack_offset++ */
    stkoff32 += 1;
    __bds_stack_offset_set(state, stkoff32);

    /* Special case: capture treehash[0] starting node at idx=3 */
    idx32 = s_idx;
    if (idx32 == 3) {
      if (TREE_HEIGHT >s BDS_K) {
        state = s_state;
        stkoff32 = __bds_stack_offset_get(state);
        stkoff = (64u)stkoff32;
        stkoff -= 1;
        tmp = __bds_stack_node_ptr(state, stkoff);
        dst = __th_node_ptr_rt(state, (64u)0);
        for j = 0 to N {
          b = [:u8 tmp + j];
          [:u8 dst + j] = b;
        }
      }
    }

    /* Merge while top two stack entries have equal height */
    while {
      state = s_state;
      comp = 0;
      stkoff32 = __bds_stack_offset_get(state);
      if (stkoff32 >=u 2) {
        stkoff = (64u)stkoff32;
        stkoff -= 1;
        slvl = __bds_stack_level_get(state, stkoff);
        stkoff -= 1;
        b = __bds_stack_level_get(state, stkoff);
        if (slvl == b) { comp = 1; }
      }
    } (comp == 1) {
      /* nodeh = height of entries being merged */
      stkoff32 = __bds_stack_offset_get(state);
      stkoff = (64u)stkoff32;
      stkoff -= 2;
      b = __bds_stack_level_get(state, stkoff);
      nodeh = (32u)b;
      nodeh64 = (64u)nodeh;

      /* Compute i_shifted = idx >> nodeh */
      idx32 = s_idx;
      i_shifted = idx32;
      th_h0 = nodeh;
      while (th_h0 >u 0) {
        i_shifted >>= 1;
        th_h0 -= 1;
      }

      state = s_state;

      /* Auth path: (idx >> nodeh) == 1 */
      if (i_shifted == 1) {
        stkoff32 = __bds_stack_offset_get(state);
        stkoff = (64u)stkoff32;
        stkoff -= 1;
        tmp = __bds_stack_node_ptr(state, stkoff);
        dst = __bds_auth_ptr_rt(state, nodeh64);
        for j = 0 to N {
          b = [:u8 tmp + j];
          [:u8 dst + j] = b;
        }
      } else {
        /* Treehash starting node: nodeh < H-K && (idx >> nodeh) == 3 */
        if (i_shifted == 3) {
          if (nodeh <u TREE_HEIGHT - BDS_K) {
            state = s_state;
            stkoff32 = __bds_stack_offset_get(state);
            stkoff = (64u)stkoff32;
            stkoff -= 1;
            tmp = __bds_stack_node_ptr(state, stkoff);
            dst = __th_node_ptr_rt(state, nodeh64);
            for j = 0 to N {
              b = [:u8 tmp + j];
              [:u8 dst + j] = b;
            }
          }
        }

        /* Retain node: nodeh >= H-K (only when not auth or treehash) */
        if (nodeh >=u TREE_HEIGHT - BDS_K) {
          /* off = (1 << (H-1-nodeh)) + nodeh - H */
          tmp = 1;
          th_h0 = TREE_HEIGHT - 1;
          th_h0 -= nodeh;
          while (th_h0 >u 0) {
            tmp <<= 1;
            th_h0 -= 1;
          }
          tmp += nodeh64;
          tmp -= TREE_HEIGHT;

          tmp2 = (64u)i_shifted;
          tmp2 -= 3;
          tmp2 >>= 1;
          tmp += tmp2;  /* slot = off + row */

          state = s_state;
          stkoff32 = __bds_stack_offset_get(state);
          stkoff = (64u)stkoff32;
          stkoff -= 1;
          dst = __bds_retain_ptr(state, tmp);
          tmp = __bds_stack_node_ptr(state, stkoff);
          for j = 0 to N {
            b = [:u8 tmp + j];
            [:u8 dst + j] = b;
          }
        }
      }

      /* Merge: H(left=stack[stkoff-2], right=stack[stkoff-1]) → stack[stkoff-2] */
      adrs = __adrs_set_type(adrs, 2);
      state = s_state;
      stkoff32 = __bds_stack_offset_get(state);
      stkoff = (64u)stkoff32;
      stkoff -= 2;
      b = __bds_stack_level_get(state, stkoff);
      nodeh = (32u)b;
      adrs = __adrs_set_tree_height(adrs, nodeh);

      /* tree_index = idx >> (nodeh+1) via constant-shift loop */
      idx32 = s_idx;
      th_h0 = nodeh;
      th_h0 += 1;
      i_shifted = idx32;
      while (th_h0 >u 0) {
        i_shifted >>= 1;
        th_h0 -= 1;
      }
      adrs = __adrs_set_tree_index(adrs, i_shifted);

      adrs_bytes = __adrs_to_bytes(adrs);
      adrs_buf = s_adrs_buf;
      for j = 0 to 32 { b = adrs_bytes[j]; [:u8 adrs_buf + j] = b; }

      /* Copy left (stack[stkoff-2]) and right (stack[stkoff-1]) to wots_buf for H */
      state = s_state;
      stkoff32 = __bds_stack_offset_get(state);
      stkoff = (64u)stkoff32;
      stkoff -= 2;
      tmp = __bds_stack_node_ptr(state, stkoff);
      wots_buf = s_wots;
      for j = 0 to N {
        b = [:u8 tmp + j];
        [:u8 wots_buf + j] = b;
      }

      state = s_state;
      stkoff32 = __bds_stack_offset_get(state);
      stkoff = (64u)stkoff32;
      stkoff -= 1;
      tmp = __bds_stack_node_ptr(state, stkoff);
      wots_buf = s_wots;
      tmp2 = wots_buf;
      tmp2 += N;
      for j = 0 to N {
        b = [:u8 tmp + j];
        [:u8 tmp2 + j] = b;
      }

      /* H(out, seed, adrs_buf, left, right) */
      h_out = s_wots;
      h_left = s_wots;
      h_right = s_wots;
      h_right += N;
      h_seed = s_seed;
      h_adrs = s_adrs_buf;
      __xmss_H(h_out, h_seed, h_adrs, h_left, h_right);

      /* Copy result back to stack[stkoff-2] */
      state = s_state;
      stkoff32 = __bds_stack_offset_get(state);
      stkoff = (64u)stkoff32;
      stkoff -= 2;
      dst = __bds_stack_node_ptr(state, stkoff);
      wots_buf = s_wots;
      for j = 0 to N {
        b = [:u8 wots_buf + j];
        [:u8 dst + j] = b;
      }

      /* Update: stack_levels[stkoff-2]++, stack_offset-- */
      state = s_state;
      stkoff32 = __bds_stack_offset_get(state);
      stkoff = (64u)stkoff32;
      stkoff -= 2;
      b = __bds_stack_level_get(state, stkoff);
      b += 1;
      __bds_stack_level_set(state, stkoff, b);
      stkoff32 -= 1;
      __bds_stack_offset_set(state, stkoff32);
    }

    /* Increment next_leaf */
    state = s_state;
    idx32 = s_idx;
    idx32 += 1;
    __bds_next_leaf_set(state, idx32);

    ret = 0;
  }

  return ret;
}
