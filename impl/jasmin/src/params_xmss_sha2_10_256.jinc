/* params_xmss_sha2_10_256.jinc — XMSS-SHA2_10_256 parameter set and require chain
 *
 * RFC 8391, OID 0x00000001: N=32, W=16, TREE_HEIGHT=10, BDS_K=2
 */

param int N           = 32;
param int W           = 16;
param int LOG2_W      = 4;
param int LEN1        = 64;
param int LEN2        = 3;
param int LEN         = 67;
param int TREE_HEIGHT = 10;
param int BDS_K       = 2;
param int XMSS_OID    = 0x00000001;

require "utils.jinc"
require "address.jinc"
require "hash/sha256_n32.jinc"
require "wots.jinc"
require "ltree.jinc"
require "treehash.jinc"
require "bds.jinc"
require "xmss.jinc"
