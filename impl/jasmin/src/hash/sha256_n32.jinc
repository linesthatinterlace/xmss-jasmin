/* sha256_n32.jinc — SHA-256 hash backend for XMSS (N=32)
 *
 * Implements SHA-256 (FIPS 180-4) and the six XMSS hash functions
 * for the SHA-2 n=32 parameter sets.
 *
 * Design: __sha256_compress takes reg ptr u8[64] because Jasmin
 * cannot convert stack array addresses to raw reg u64 pointers.
 * Callers copy external data into a local block buffer, then pass
 * as reg ptr.
 */

/* SHA-256 round constants (FIPS 180-4 §4.2.2) */
u32[64] SHA256_K = {
  0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5,
  0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
  0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3,
  0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
  0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc,
  0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
  0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7,
  0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
  0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13,
  0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
  0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3,
  0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
  0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5,
  0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
  0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208,
  0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2
};

/* SHA-256 initial hash values (FIPS 180-4 §5.3.3) */
u32[8] SHA256_IV = {
  0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a,
  0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19
};

/* Initialize SHA-256 state to IV */
inline fn __sha256_init() -> stack u32[8] {
  stack u32[8] state;
  reg u32 tmp;
  inline int i;
  for i = 0 to 8 {
    tmp = SHA256_IV[i];
    state[i] = tmp;
  }
  return state;
}

/* Copy 64 bytes from reg u64 pointer to stack u8[64] */
inline fn __load_block(reg u64 src) -> stack u8[64] {
  stack u8[64] blk;
  reg u64 v;
  inline int i;
  for i = 0 to 8 {
    v = [:u64 src + 8 * i];
    blk[:u64 i] = v;
  }
  return blk;
}

/* SHA-256 compression function (FIPS 180-4 §6.2.2).
 * state: 8 x u32 hash state (modified in place)
 * block: 64-byte input block (reg ptr) */
inline fn __sha256_compress(stack u32[8] state, stack u8[64] block)
    -> stack u32[8] {
  stack u32[64] w;
  reg u32 a b c d e f g h;
  reg u32 t1 t2 s0 s1 ch maj tmp tmp2;
  inline int i;

  /* Message schedule: W[0..15] — load each 4-byte group as big-endian u32 */
  for i = 0 to 16 {
    tmp = __load_be32(block, 4*i);
    w[i] = tmp;
  }

  /* Message schedule: W[16..63] */
  for i = 16 to 64 {
    tmp = w[i - 15];
    s0 = tmp; s0 >>r= 7;
    tmp2 = tmp; tmp2 >>r= 18;
    s0 ^= tmp2;
    tmp >>= 3;
    s0 ^= tmp;

    tmp = w[i - 2];
    s1 = tmp; s1 >>r= 17;
    tmp2 = tmp; tmp2 >>r= 19;
    s1 ^= tmp2;
    tmp >>= 10;
    s1 ^= tmp;

    tmp = w[i - 16];
    tmp += s0;
    tmp2 = w[i - 7];
    tmp += tmp2;
    tmp += s1;
    w[i] = tmp;
  }

  a = state[0]; b = state[1]; c = state[2]; d = state[3];
  e = state[4]; f = state[5]; g = state[6]; h = state[7];

  for i = 0 to 64 {
    s1 = e; s1 >>r= 6;
    tmp = e; tmp >>r= 11;
    s1 ^= tmp;
    tmp = e; tmp >>r= 25;
    s1 ^= tmp;

    ch = e;
    ch &= f;
    tmp = e;
    tmp = !tmp;
    tmp &= g;
    ch ^= tmp;

    t1 = h;
    t1 += s1;
    t1 += ch;
    tmp = SHA256_K[i];
    t1 += tmp;
    tmp = w[i];
    t1 += tmp;

    s0 = a; s0 >>r= 2;
    tmp = a; tmp >>r= 13;
    s0 ^= tmp;
    tmp = a; tmp >>r= 22;
    s0 ^= tmp;

    maj = a;
    maj &= b;
    tmp = a;
    tmp &= c;
    maj ^= tmp;
    tmp = b;
    tmp &= c;
    maj ^= tmp;

    t2 = s0;
    t2 += maj;

    h = g; g = f; f = e;
    e = d; e += t1;
    d = c; c = b; b = a;
    a = t1; a += t2;
  }

  tmp = state[0]; a += tmp; state[0] = a;
  tmp = state[1]; b += tmp; state[1] = b;
  tmp = state[2]; c += tmp; state[2] = c;
  tmp = state[3]; d += tmp; state[3] = d;
  tmp = state[4]; e += tmp; state[4] = e;
  tmp = state[5]; f += tmp; state[5] = f;
  tmp = state[6]; g += tmp; state[6] = g;
  tmp = state[7]; h += tmp; state[7] = h;

  return state;
}

/* Copy stack u8[N] to a reg u64 output pointer */
inline fn __store_n(reg u64 out, stack u8[N] src) {
  reg u8 b;
  inline int i;
  for i = 0 to N { b = src[i]; [:u8 out + i] = b; }
}

/* Write SHA-256 state as big-endian bytes to output pointer */
inline fn __sha256_store_hash(reg u64 out, stack u32[8] state) {
  stack u8[N] buf;
  buf = __u32x8_to_be_bytes(state);
  __store_n(out, buf);
}

/* SHA-256 one-shot: hash inlen bytes at inp, write 32 bytes at out. */
fn __sha256_oneshot(reg u64 out, reg u64 inp, reg u64 inlen) {
  stack u32[8] state;
  stack u8[64] blk;
  reg ptr u8[64] blkp;
  reg u64 bitcount remaining;
  reg u8 b;
  reg u32 tmp32;
  inline int i;

  state = __sha256_init();

  bitcount = inlen;
  bitcount <<= 3;

  remaining = inlen;
  while (remaining >=u 64) {
    blk = __load_block(inp);
    blkp = blk;
    state = __sha256_compress(state, blkp);
    inp += 64;
    remaining -= 64;
  }

  /* Build final block(s) with padding */
  for i = 0 to 8 { blk[:u64 i] = 0; }

  inlen = remaining;
  remaining = 0;
  while (remaining <u inlen) {
    b = [:u8 inp + remaining];
    blk[(uint)remaining] = b;
    remaining += 1;
  }

  blk[(uint)inlen] = 0x80;

  tmp32 = (32u)inlen;
  tmp32 += 9;
  if (tmp32 >u 64) {
    blkp = blk;
    state = __sha256_compress(state, blkp);
    for i = 0 to 8 { blk[:u64 i] = 0; }
  }

  blk = __store_be64(blk, 56, bitcount);

  blkp = blk;
  state = __sha256_compress(state, blkp);

  __sha256_store_hash(out, state);
}

/* ====================================================================
 * XMSS hash functions for SHA-2 N=32
 *
 * Internal functions (__sha256_prf_internal etc.) return stack u8[N]
 * because Jasmin cannot produce a reg u64 pointer to a stack array.
 * External-facing functions write to a reg u64 output pointer.
 * ==================================================================== */

/* Hash 96 bytes from ibuf: 1 full block + 32 partial + padding.
 * Returns the 32-byte hash as a stack array. */
inline fn __sha256_hash96(stack u8[96] ibuf) -> stack u8[N] {
  stack u8[N] result;
  stack u8[64] blk;
  reg ptr u8[64] blkp;
  stack u32[8] state;
  reg u64 bitcount;
  reg u8 b;
  inline int i;

  state = __sha256_init();

  for i = 0 to 64 { b = ibuf[i]; blk[i] = b; }
  blkp = blk;
  state = __sha256_compress(state, blkp);

  for i = 0 to 8 { blk[:u64 i] = 0; }
  for i = 0 to 32 { b = ibuf[64 + i]; blk[i] = b; }
  blk[32] = 0x80;
  bitcount = 96 * 8;
  blk = __store_be64(blk, 56, bitcount);
  blkp = blk;
  state = __sha256_compress(state, blkp);

  result = __u32x8_to_be_bytes(state);
  return result;
}

/* Hash 128 bytes from ibuf: 2 full blocks + padding block.
 * Returns the 32-byte hash as a stack array. */
inline fn __sha256_hash128(stack u8[128] ibuf) -> stack u8[N] {
  stack u8[N] result;
  stack u8[64] blk;
  reg ptr u8[64] blkp;
  stack u32[8] state;
  reg u64 bitcount;
  reg u8 b;
  inline int i;

  state = __sha256_init();

  for i = 0 to 64 { b = ibuf[i]; blk[i] = b; }
  blkp = blk;
  state = __sha256_compress(state, blkp);

  for i = 0 to 64 { b = ibuf[64 + i]; blk[i] = b; }
  blkp = blk;
  state = __sha256_compress(state, blkp);

  for i = 0 to 8 { blk[:u64 i] = 0; }
  blk[0] = 0x80;
  bitcount = 128 * 8;
  blk = __store_be64(blk, 56, bitcount);
  blkp = blk;
  state = __sha256_compress(state, blkp);

  result = __u32x8_to_be_bytes(state);
  return result;
}

/* Internal PRF: SHA-256(toByte(dom, N) || key || M)
 * where M is 32 bytes. Total 96 bytes. Returns stack u8[N]. */
inline fn __sha256_prf_internal(inline int domain, reg u64 key, reg u64 m)
    -> stack u8[N] {
  stack u8[96] ibuf;
  stack u8[N] result;
  reg u8 b;
  inline int i;

  for i = 0 to N - 1 { ibuf[i] = 0; }
  ibuf[N - 1] = domain;
  for i = 0 to N { b = [:u8 key + i]; ibuf[N + i] = b; }
  for i = 0 to 32 { b = [:u8 m + i]; ibuf[2 * N + i] = b; }

  result = __sha256_hash96(ibuf);
  return result;
}

/* __xmss_PRF — PRF(KEY, ADRS) = SHA-256(toByte(3, N) || KEY || ADRS) — domain 0x03 = PRF
 * External interface: writes N bytes to out pointer. */
fn __xmss_PRF(reg u64 out, reg u64 key, reg u64 adrs_bytes) {
  stack u8[N] result;
  result = __sha256_prf_internal(0x03, key, adrs_bytes);
  __store_n(out, result);
}

/* __xmss_PRF_keygen — SHA-256(toByte(4, N) || SK_SEED || PUB_SEED || ADRS)
 * Input: N + N + N + 32 = 128 bytes for N=32. */
fn __xmss_PRF_keygen(reg u64 out, reg u64 sk_seed, reg u64 pub_seed,
                     reg u64 adrs_bytes) {
  stack u8[128] ibuf;
  stack u8[N] result;
  reg u8 b;
  inline int i;

  for i = 0 to N - 1 { ibuf[i] = 0; }
  ibuf[N - 1] = 0x04;  /* domain 0x04 = PRF_keygen */
  for i = 0 to N { b = [:u8 sk_seed + i]; ibuf[N + i] = b; }
  for i = 0 to N { b = [:u8 pub_seed + i]; ibuf[2 * N + i] = b; }
  for i = 0 to 32 { b = [:u8 adrs_bytes + i]; ibuf[3 * N + i] = b; }

  result = __sha256_hash128(ibuf);
  __store_n(out, result);
}

/* __xmss_F — WOTS+ chaining function
 *   key_val = PRF(PUB_SEED, ADRS[km=0])
 *   bm      = PRF(PUB_SEED, ADRS[km=1])
 *   F       = SHA-256(toByte(0, N) || key_val || (M XOR bm))
 *
 * adrs_bytes: km field (bytes 28-31) is modified then restored. */
fn __xmss_F(reg u64 out, reg u64 pub_seed, reg u64 adrs_bytes,
            reg u64 inp) {
  stack u8[N] prf_key bitmask;
  stack u8[96] ibuf;
  stack u8[N] result;
  stack u64 s_out s_pub_seed s_inp s_adrs;
  reg u8 b1 b2;
  inline int i;

  s_out = out;
  s_pub_seed = pub_seed;
  s_inp = inp;
  s_adrs = adrs_bytes;

  /* km=0: generate key.
   * Note: the reload of adrs_bytes before each fn call is not redundant —
   * Jasmin fn calls clobber all reg variables; the reload after writing the km
   * field (before the call) is a belt-and-braces guard against that. */
  adrs_bytes = s_adrs;
  [:u32 adrs_bytes + 28] = 0;
  pub_seed = s_pub_seed;
  adrs_bytes = s_adrs;
  prf_key = __sha256_prf_internal(0x03, pub_seed, adrs_bytes);

  /* km=1: generate bitmask */
  adrs_bytes = s_adrs;
  [:u32 adrs_bytes + 28] = 0x01000000;  /* BE 0x00000001 in LE memory */
  pub_seed = s_pub_seed;
  adrs_bytes = s_adrs;
  bitmask = __sha256_prf_internal(0x03, pub_seed, adrs_bytes);

  /* Restore km=0 */
  adrs_bytes = s_adrs;
  [:u32 adrs_bytes + 28] = 0;

  /* Build: toByte(0, N) || prf_key || (inp XOR bitmask) — domain 0x00 = F */
  for i = 0 to N - 1 { ibuf[i] = 0; }
  ibuf[N - 1] = 0x00;
  for i = 0 to N { b1 = prf_key[i]; ibuf[N + i] = b1; }
  inp = s_inp;
  for i = 0 to N {
    b1 = [:u8 inp + i];
    b2 = bitmask[i];
    b1 ^= b2;
    ibuf[2 * N + i] = b1;
  }

  result = __sha256_hash96(ibuf);

  out = s_out;
  __store_n(out, result);
}

/* __xmss_H — Tree hash function
 *   key_val = PRF(PUB_SEED, ADRS[km=0])
 *   bm_l    = PRF(PUB_SEED, ADRS[km=1])
 *   bm_r    = PRF(PUB_SEED, ADRS[km=2])
 *   H = SHA-256(toByte(1,N) || key || (M_l XOR bm_l) || (M_r XOR bm_r))
 * Input: 4N = 128 bytes. */
fn __xmss_H(reg u64 out, reg u64 pub_seed, reg u64 adrs_bytes,
            reg u64 in_l, reg u64 in_r) {
  stack u8[N] prf_key bm_l bm_r;
  stack u8[128] ibuf;
  stack u8[N] result;
  stack u64 s_out s_pub_seed s_in_l s_in_r s_adrs;
  reg u8 b1 b2;
  inline int i;

  s_out = out;
  s_pub_seed = pub_seed;
  s_in_l = in_l;
  s_in_r = in_r;
  s_adrs = adrs_bytes;

  /* km=0: key */
  adrs_bytes = s_adrs;
  [:u32 adrs_bytes + 28] = 0;
  pub_seed = s_pub_seed;
  adrs_bytes = s_adrs;
  prf_key = __sha256_prf_internal(0x03, pub_seed, adrs_bytes);

  /* km=1: left bitmask */
  adrs_bytes = s_adrs;
  [:u32 adrs_bytes + 28] = 0x01000000;
  pub_seed = s_pub_seed;
  adrs_bytes = s_adrs;
  bm_l = __sha256_prf_internal(0x03, pub_seed, adrs_bytes);

  /* km=2: right bitmask */
  adrs_bytes = s_adrs;
  [:u32 adrs_bytes + 28] = 0x02000000;
  pub_seed = s_pub_seed;
  adrs_bytes = s_adrs;
  bm_r = __sha256_prf_internal(0x03, pub_seed, adrs_bytes);

  /* Restore km=0 */
  adrs_bytes = s_adrs;
  [:u32 adrs_bytes + 28] = 0;

  /* Build: toByte(1, N) || prf_key || (in_l XOR bm_l) || (in_r XOR bm_r) — domain 0x01 = H */
  for i = 0 to N - 1 { ibuf[i] = 0; }
  ibuf[N - 1] = 0x01;
  for i = 0 to N { b1 = prf_key[i]; ibuf[N + i] = b1; }

  in_l = s_in_l;
  for i = 0 to N {
    b1 = [:u8 in_l + i];
    b2 = bm_l[i];
    b1 ^= b2;
    ibuf[2 * N + i] = b1;
  }

  in_r = s_in_r;
  for i = 0 to N {
    b1 = [:u8 in_r + i];
    b2 = bm_r[i];
    b1 ^= b2;
    ibuf[3 * N + i] = b1;
  }

  result = __sha256_hash128(ibuf);

  out = s_out;
  __store_n(out, result);
}

/* __xmss_H_msg — Message hash (variable length)
 *   H_msg = SHA-256(toByte(2, N) || r || root || toByte(idx, N) || msg)
 * Prefix is 4N = 128 bytes, then variable-length msg. */
fn __xmss_H_msg(reg u64 out, reg u64 r, reg u64 root,
                reg u64 idx_bytes_buf, reg u64 msg, reg u64 msglen) {
  stack u8[128] prefix;
  stack u8[64] blk;
  reg ptr u8[64] blkp;
  stack u32[8] state;
  stack u64 s_out s_msglen_orig;
  reg u64 total_bits;
  reg u64 buflen;
  reg u32 tmp32;
  reg u8 b;
  inline int i;

  s_out = out;
  s_msglen_orig = msglen;

  /* Build 128-byte prefix — domain 0x02 = H_msg */
  for i = 0 to N - 1 { prefix[i] = 0; }
  prefix[N - 1] = 0x02;
  for i = 0 to N { b = [:u8 r + i]; prefix[N + i] = b; }
  for i = 0 to N { b = [:u8 root + i]; prefix[2 * N + i] = b; }
  for i = 0 to N { b = [:u8 idx_bytes_buf + i]; prefix[3 * N + i] = b; }

  /* Process prefix: 2 full blocks */
  state = __sha256_init();
  for i = 0 to 64 { b = prefix[i]; blk[i] = b; }
  blkp = blk;
  state = __sha256_compress(state, blkp);
  for i = 0 to 64 { b = prefix[64 + i]; blk[i] = b; }
  blkp = blk;
  state = __sha256_compress(state, blkp);

  /* Process full message blocks */
  while (msglen >=u 64) {
    blk = __load_block(msg);
    blkp = blk;
    state = __sha256_compress(state, blkp);
    msg += 64;
    msglen -= 64;
  }

  /* Final block: remaining msg bytes + padding */
  for i = 0 to 8 { blk[:u64 i] = 0; }
  buflen = 0;
  while (msglen >u 0) {
    b = [:u8 msg];
    blk[(uint)buflen] = b;
    buflen += 1;
    msg += 1;
    msglen -= 1;
  }

  blk[(uint)buflen] = 0x80;

  tmp32 = (32u)buflen;
  tmp32 += 9;
  if (tmp32 >u 64) {
    blkp = blk;
    state = __sha256_compress(state, blkp);
    for i = 0 to 8 { blk[:u64 i] = 0; }
  }

  total_bits = s_msglen_orig;
  total_bits += 128;
  total_bits <<= 3;
  blk = __store_be64(blk, 56, total_bits);
  blkp = blk;
  state = __sha256_compress(state, blkp);

  out = s_out;
  __sha256_store_hash(out, state);
}

/* __xmss_PRF_idx — PRF(SK_PRF, toByte(idx, 32))
 * Same domain (0x03) and layout as __xmss_PRF; inlined to avoid call overhead. */
inline fn __xmss_PRF_idx(reg u64 out, reg u64 sk_prf, reg u64 idx_32bytes) {
  __xmss_PRF(out, sk_prf, idx_32bytes);
}

/* ====================================================================
 * Algorithm-layer inline wrappers
 *
 * These accept reg ptr / stack arrays (obtainable from stack locals)
 * instead of reg u64 pointers, working around Jasmin's inability to
 * take the address of a stack variable as reg u64.
 * ==================================================================== */

/* PRF wrapper for algorithm layer: key and m as reg ptr */
inline fn __sha256_prf_rp(inline int domain,
                           reg ptr u8[32] key_rp,
                           reg ptr u8[32] m_rp) -> stack u8[N] {
  stack u8[96] ibuf;
  stack u8[N] result;
  reg u8 b;
  inline int i;
  for i = 0 to N - 1 { ibuf[i] = 0; }
  ibuf[N - 1] = domain;
  for i = 0 to N  { b = key_rp[i]; ibuf[N + i] = b; }
  for i = 0 to 32 { b = m_rp[i];  ibuf[2 * N + i] = b; }
  result = __sha256_hash96(ibuf);
  return result;
}

/* PRF_keygen wrapper: SHA-256(toByte(4,N) || sk_seed || pub_seed || adrs_bytes)
 * Total: N + N + N + 32 = 128 bytes for N=32. */
inline fn __xmss_PRF_keygen_rp(reg ptr u8[32] sk_seed_rp,
                                reg ptr u8[32] pub_seed_rp,
                                reg ptr u8[32] adrs_bytes_rp) -> stack u8[N] {
  stack u8[128] ibuf;
  stack u8[N] result;
  reg u8 b;
  inline int i;
  for i = 0 to N - 1 { ibuf[i] = 0; }
  ibuf[N - 1] = 0x04;  /* domain 0x04 = PRF_keygen */
  for i = 0 to N  { b = sk_seed_rp[i]; ibuf[N + i] = b; }
  for i = 0 to N  { b = pub_seed_rp[i]; ibuf[2 * N + i] = b; }
  for i = 0 to 32 { b = adrs_bytes_rp[i]; ibuf[3 * N + i] = b; }
  result = __sha256_hash128(ibuf);
  return result;
}

/* F wrapper for algorithm layer: operates on stack arrays directly.
 * F = SHA-256(toByte(0,N) || PRF(seed,adrs[km=0]) || (node XOR PRF(seed,adrs[km=1])))
 */
inline fn __xmss_F_rp(stack u8[N] node,
                       reg ptr u8[32] seed_rp,
                       stack u8[32] adrs_bytes) -> stack u8[N] {
  stack u8[32] akm0 akm1;
  reg ptr u8[32] akm0p akm1p;
  stack u8[N] prf_key bitmask result;
  stack u8[96] ibuf;
  reg u8 b1 b2;
  inline int i;

  /* Build km=0 and km=1 copies of adrs_bytes */
  for i = 0 to 32 { b1 = adrs_bytes[i]; akm0[i] = b1; akm1[i] = b1; }
  /* Set km field (bytes 28-31, big-endian u32) */
  akm0[28] = 0; akm0[29] = 0; akm0[30] = 0; akm0[31] = 0;
  akm1[28] = 0; akm1[29] = 0; akm1[30] = 0; akm1[31] = 1;
  akm0p = akm0; akm1p = akm1;

  prf_key = __sha256_prf_rp(0x03, seed_rp, akm0p);
  bitmask = __sha256_prf_rp(0x03, seed_rp, akm1p);

  for i = 0 to N - 1 { ibuf[i] = 0; }
  ibuf[N - 1] = 0x00;
  for i = 0 to N { b1 = prf_key[i]; ibuf[N + i] = b1; }
  for i = 0 to N {
    b1 = node[i]; b2 = bitmask[i]; b1 ^= b2;
    ibuf[2 * N + i] = b1;
  }

  result = __sha256_hash96(ibuf);
  return result;
}

