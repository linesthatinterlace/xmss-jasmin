/* test_ltree.jazz — test harness for L-tree */

param int N       = 32;
param int W       = 16;
param int LOG2_W  = 4;
param int LEN1    = 64;
param int LEN2    = 3;
param int LEN     = 67;

require "../src/address.jinc"
require "../src/hash/sha256_n32.jinc"
require "../src/ltree.jinc"

/* Export ltree for C test harness */
export fn test_ltree(reg u64 root, reg u64 pk, reg u64 seed,
                     reg u64 adrs_ptr) -> reg u64 {
  stack u32[8] adrs;
  reg ptr u32[8] adrs_rp;
  stack u64 s_root s_pk s_seed;
  reg u32 w;
  reg u64 r;
  inline int i;

  _ = #init_msf();

  s_root = root;
  s_pk = pk;
  s_seed = seed;

  for i = 0 to 8 {
    w = [:u32 adrs_ptr + 4 * i];
    w = #BSWAP_32(w);
    adrs[i] = w;
  }

  /* We need a reg u64 pointer to scratch space for ADRS serialization.
     Use #LEA or just pass the adrs_ptr (caller's buffer) as scratch. */

  root = s_root;
  pk = s_pk;
  seed = s_seed;
  adrs_rp = adrs;

  /* Reuse the caller's adrs_ptr buffer (32 bytes) as scratch space */
  __ltree(root, pk, seed, adrs_ptr, adrs_rp);

  ?{}, r = #set0();
  return r;
}
