/* test_xmss.jazz — thin export wrappers for XMSS keygen, sign, verify
 *
 * Params: XMSS-SHA2_10_256
 */

require "../src/params_xmss_sha2_10_256.jinc"

#[ct = "public × public × public × public × public → public"]
export fn test_xmss_keygen(reg u64 pk, reg u64 sk, reg u64 state,
                            reg u64 seeds, reg u64 scratch) -> reg u64 {
  reg u64 r;
  _ = #init_msf();
  r = __xmss_keygen(pk, sk, state, seeds, scratch);
  return r;
}

#[ct = "public × public × public × public × public × public → public"]
export fn test_xmss_sign(reg u64 sig, reg u64 msg, reg u64 msglen,
                          reg u64 sk, reg u64 state,
                          reg u64 scratch) -> reg u64 {
  reg u64 r;
  _ = #init_msf();
  r = __xmss_sign(sig, msg, msglen, sk, state, scratch);
  return r;
}

#[ct = "public × public × public × public × public → secret"]
export fn test_xmss_verify(reg u64 msg, reg u64 msglen, reg u64 sig,
                            reg u64 pk, reg u64 scratch) -> reg u64 {
  reg u64 r;
  _ = #init_msf();
  r = __xmss_verify(msg, msglen, sig, pk, scratch);
  return r;
}
