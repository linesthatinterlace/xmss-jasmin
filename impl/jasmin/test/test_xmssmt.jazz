/* test_xmssmt.jazz — thin export wrappers for XMSS-MT keygen, sign, verify
 *
 * Params: XMSSMT-SHA2_20/2_256
 */

require "../src/params_xmssmt_sha2_20_2_256.jinc"

#[ct = "public × public × public × public × public → public"]
export fn test_xmssmt_keygen(reg u64 pk, reg u64 sk, reg u64 mt_state,
                              reg u64 seeds, reg u64 scratch) -> reg u64 {
  reg u64 r;
  _ = #init_msf();
  r = __xmssmt_keygen(pk, sk, mt_state, seeds, scratch);
  return r;
}

#[ct = "public × public × public × public × public × public → public"]
export fn test_xmssmt_sign(reg u64 sig, reg u64 msg, reg u64 msglen,
                            reg u64 sk, reg u64 mt_state,
                            reg u64 scratch) -> reg u64 {
  reg u64 r;
  _ = #init_msf();
  r = __xmssmt_sign(sig, msg, msglen, sk, mt_state, scratch);
  return r;
}

#[ct = "public × public × public × public × public → secret"]
export fn test_xmssmt_verify(reg u64 msg, reg u64 msglen, reg u64 sig,
                              reg u64 pk, reg u64 scratch) -> reg u64 {
  reg u64 r;
  _ = #init_msf();
  r = __xmssmt_verify(msg, msglen, sig, pk, scratch);
  return r;
}
