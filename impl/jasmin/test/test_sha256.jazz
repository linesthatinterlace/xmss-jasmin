/* test_sha256.jazz — test wrapper for SHA-256 */

param int N = 32;

require "../src/utils.jinc"
require "../src/hash/sha256_n32.jinc"

/* One-shot SHA-256: hash inlen bytes at inp, write 32 bytes at out */
#[ct = "public × public × public → public"]
export fn test_sha256(reg u64 out, reg u64 inp, reg u64 inlen) -> reg u64 {
  reg u64 r;
  _ = #init_msf();
  __sha256_oneshot(out, inp, inlen);
  r = 0;
  return r;
}

/* Test PRF: out = SHA-256(toByte(3, 32) || key || m) */
#[ct = "public × public × public → public"]
export fn test_xmss_prf(reg u64 out, reg u64 key, reg u64 adrs_bytes) -> reg u64 {
  reg u64 r;
  _ = #init_msf();
  __xmss_PRF(out, key, adrs_bytes);
  r = 0;
  return r;
}
